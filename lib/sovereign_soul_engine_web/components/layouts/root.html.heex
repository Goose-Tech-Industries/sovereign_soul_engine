<!DOCTYPE html>
<html lang="en" data-theme="dark" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="SovereignSoulEngine" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href="/sse/assets/css/app.css" />
    <link rel="manifest" href="/sse/manifest.json" />
    <link rel="apple-touch-icon" href="/sse/images/app-icon.svg" />
    <meta name="theme-color" content="#090d16" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Feannag's Rest" />
    <script defer phx-track-static type="text/javascript" src="/sse/assets/js/app.js">
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sse/sw.js').catch(err => {
            console.log('[PWA] ServiceWorker registration failed: ', err);
          });
        });
      }
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    <header class="w-full relative z-20 flex items-center justify-between px-4 sm:px-6 py-2 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-sm text-xs">
      <div class="flex items-center gap-3">
        <.link navigate={~p"/"} class="font-bold text-sm tracking-tight text-white flex items-center gap-1.5 hover:text-primary transition-colors">
          <span class="text-primary font-black">✦</span> Sovereign Soul
        </.link>
        <span class="hidden sm:inline text-slate-500">|</span>
        <.link navigate={~p"/sse/chat"} class="text-slate-300 hover:text-white transition-colors font-medium hidden sm:inline">
          Companion Sanctuary
        </.link>
        <.link navigate={~p"/sse/feed"} class="text-slate-400 hover:text-white transition-colors hidden md:inline">
          Social Feed
        </.link>
      </div>

      <ul class="flex items-center gap-3 text-slate-400">
        <%= if @current_scope && @current_scope.user do %>
          <li class="text-slate-300 font-medium">
            {@current_scope.user.email}
          </li>
          <li>
            <.link href={~p"/sse/billing"} class="text-primary font-bold hover:underline">
              Subscription
            </.link>
          </li>
          <li>
            <.link href={~p"/users/settings"} class="hover:text-white transition-colors">
              Settings & Privacy
            </.link>
          </li>
          <li>
            <.link href={~p"/users/log-out"} method="delete" class="text-rose-400 hover:text-rose-300 transition-colors">
              Log out
            </.link>
          </li>
        <% else %>
          <li>
            <.link href={~p"/users/log-in"} class="hover:text-white transition-colors">
              Log in
            </.link>
          </li>
          <li>
            <.link href={~p"/users/register"} class="btn btn-primary btn-xs font-bold px-3">
              Get Started
            </.link>
          </li>
        <% end %>
      </ul>
    </header>
    {@inner_content}
  </body>
</html>
